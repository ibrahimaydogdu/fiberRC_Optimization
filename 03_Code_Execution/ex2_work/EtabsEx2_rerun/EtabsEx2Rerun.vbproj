<Project Sdk="Microsoft.NET.Sdk">
  <!-- Ex2 V2-a re-validation (2026-11-16, pilot 2 + K1) against ETABS 22. Read-only file references to the FROZEN binaries in 03_Code_Execution/ex2_bin
       (Ex2Model.dll d0514e2f...) and ex2_work/ref; nothing in ex2_work or ex2_bin is rebuilt. Copy of ../EtabsEx2 (that tool is kept unchanged). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>EtabsEx2Rerun</RootNamespace>
    <AssemblyName>EtabsEx2Rerun</AssemblyName>
    <OptionStrict>Off</OptionStrict>
    <OptionInfer>On</OptionInfer>
    <NoWarn>42016,41999,42017,42018,42019,42032,42036,42020,42021,42022</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="ETABSv1"><HintPath>C:\Program Files\Computers and Structures\ETABS 22\ETABSv1.dll</HintPath><Private>True</Private></Reference>
    <Reference Include="Ex2Model"><HintPath>..\..\ex2_bin\Ex2Model.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="FemCore"><HintPath>..\ref\FemCore.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="RcCore"><HintPath>..\ref\RcCore.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="FemRcModel"><HintPath>..\ref\FemRcModel.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="MathNet.Numerics"><HintPath>..\ref\MathNet.Numerics.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="System.ValueTuple"><HintPath>..\ref\System.ValueTuple.dll</HintPath><Private>true</Private></Reference>
  </ItemGroup>
</Project>
